 drop table member;

 create table member(
    member_id bigint primary key auto_increment,
    homepage_id varchar(20),
    password varchar(64),
    open_id varchar(255),
    name varchar(64),
    email varchar(30),
    phone varchar(15),
    regdate DATETIME default CURRENT_TIMESTAMP,
    updated datetime default current_timestamp on update current_timestamp,
    provider_id int,
    constraint fk_provider_member foreign key (provider_id) references provider(provider_id)
 );


